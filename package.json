{
  "name": "brisk-legal-mern",
  "version": "1.0.0",
  "private": true,
  "description": "MERN website for Brisk Legal.",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --workspace client",
    "server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "supabase:email-template": "node scripts/apply-supabase-email-template.mjs"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
